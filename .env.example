# proxy 監聽位址；Claude Code 端設定 ANTHROPIC_BASE_URL=http://127.0.0.1:8787
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8787

# 一般內容原樣轉送的目的地
CLOUD_URL=https://api.anthropic.com

# 受限內容改送的本地模型（需支援 Anthropic Messages API，例如 llama.cpp server）
LOCAL_URL=http://192.168.1.100:8081
LOCAL_MODEL=your-local-model
LOCAL_API_KEY=

# 決策模型；留空 DECISION_URL 代表一律走雲端
# systemone：h2o-lightning（scripts/serve-decision.sh 啟動）
# chat：一般 OpenAI 相容模型，回 LOCAL / CLOUD
DECISION_URL=http://127.0.0.1:8741
DECISION_API=systemone
DECISION_THRESHOLD=0.5
DECISION_MODEL=decision
DECISION_API_KEY=
DECISION_TIMEOUT=30
# 換掉預設的判斷問題（systemone）或 system prompt（chat）
DECISION_PROMPT_FILE=
# 決策模型掛掉時往哪送：local（寧可慢也不外流）或 cloud
DECISION_ON_ERROR=local

STATE_FILE=state/sessions.json
LOG_FILE=logs/router.jsonl
# 1 = 另存完整 request body 到 logs/bodies/（除錯用，內容含完整對話）
LOG_BODIES=0
